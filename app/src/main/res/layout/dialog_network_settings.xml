<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1A1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Введите данные Wi-Fi сети"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etSsid"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#333333"
        android:hint="Имя сети (SSID)"
        android:paddingStart="12dp"
        android:text="TP-Link_6B15"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#333333"
        android:hint="Пароль"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:text="88605678"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <CheckBox
        android:id="@+id/cbDhcp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:checked="false"
        android:text="Получать IP автоматически (DHCP)"
        android:textColor="#FFFFFF" />

    <EditText
        android:id="@+id/etIp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:background="#333333"
        android:enabled="false"
        android:hint="Статический IP (например, 192.168.0.200)"
        android:paddingStart="12dp"
        android:text="http://192.168.4.1"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888" />

    <!-- Подсказка для статического IP -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ℹ️ При выборе статического IP убедитесь, что адрес свободен в вашей сети."
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:id="@+id/tvIpHint" />

</LinearLayout>